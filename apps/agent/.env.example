# TYZ agent (realm/rust) — same variable names and semantics as the legacy Go agent.
# Real environment variables take precedence over this file (dotenvy).

# Control plane base URL (required)
CONTROL_PLANE_URL=https://worker.example.workers.dev
# Node bearer token (required)
NODE_TOKEN=

# HTTP poll interval while the WS push channel is down (ms)
POLL_INTERVAL_MS=10000
# Traffic-sample upload interval (ms); startup phase is randomized across the
# fleet. The node heartbeat is NOT configurable — fixed at 60s (WS beat or
# POST /api/agent/heartbeat in poll mode).
STATS_FLUSH_INTERVAL_MS=60000

# WebSocket push channel
WS_ENABLED=true
WS_PROBE_INTERVAL_MS=60000

# Verbose logging
DEBUG=false
