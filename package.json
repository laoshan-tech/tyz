{
  "name": "tyz",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:agent": "cd apps/agent && cargo run",
    "test:agent": "cd apps/agent && cargo test",
    "clippy:agent": "cd apps/agent && cargo clippy --all-targets",
    "dev:server": "wrangler dev",
    "dev:web": "bun run --filter @tyz/web dev",
    "build:web": "bun run --filter @tyz/web build",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file apps/server/scripts/seed-local.sql",
    "deploy:server": "wrangler deploy && bun run db:migrate",
    "type-check": "bun run --filter '*' type-check",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
